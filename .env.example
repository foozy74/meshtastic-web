# BLE MAC-Adresse deines RAK4631 (z. B. via 'bluetoothctl scan on' ermitteln)
BLE_ADDRESS=XX:XX:XX:XX:XX:XX

# Web UI Port auf dem Raspberry Pi (Standard: 8080)
WEB_PORT=8080

# Erlaubte Origins für den Webzugriff (CORS, * erlaubt alle LAN-IPs und Hostnames)
ALLOWED_ORIGINS=*

# Geheimer Schlüssel für Web-Sessions
SESSION_SECRET=a_very_secret_key_change_me_12345
